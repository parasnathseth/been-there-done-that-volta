# Copy this file to .env and fill in real values. Never commit .env.

# Supabase Postgres connection string.
# In Supabase: Project > Connect > "Session pooler" (works on IPv4 networks).
# Format: postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Port the local backend runs on
PORT=3000

# AI model used to compare problems by meaning (runs on our server)
MODEL_ID=Xenova/all-MiniLM-L6-v2

# Minimum similarity score (0 to 1) for a story to be shown as a match.
# 0.40 was chosen with the test blockers in data/eval-pairs.js (npm run eval).
MATCH_MIN_SCORE=0.40
